{
  "name": "spicyapi-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Telegram and Discord bot for SpicyAPI: images, videos and character chat, with spend limits.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "npm run build && node --env-file-if-exists=.env dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "live-check": "npm run build && node --env-file-if-exists=.env dist/scripts/live-check.js"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "2.0.2",
    "@spicyapi/sdk": "0.8.0",
    "discord.js": "14.27.0",
    "grammy": "1.46.0",
    "openai": "7.28.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
